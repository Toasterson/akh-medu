{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akh-medu.dev/schemas/lilith/cos-commitment@1",
  "title": "Lilith CoS commitment v1",
  "description": "A commitment Lilith keeps (her own, the operator's, or a delegate's she chases). Closed only on evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "language",
    "owner",
    "statement",
    "closing_evidence",
    "status",
    "receipts"
  ],
  "properties": {
    "contract": {
      "const": "lilith/cos-commitment@1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "owner": {
      "enum": [
        "lilith",
        "operator",
        "delegate"
      ]
    },
    "counterparty": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "due_at": {
      "$ref": "#/$defs/unixSeconds"
    },
    "closing_evidence": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "open"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "at-risk"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "blocked"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "closed"
            },
            "evidence": {
              "$ref": "#/$defs/receipts"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "dropped"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      }
    },
    "receipts": {
      "$ref": "#/$defs/receipts"
    }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "work-item",
            "plan",
            "pull-request",
            "commit",
            "run",
            "board-thread",
            "akh",
            "host",
            "document"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag of the operator's (or recipient's) language, detected structurally."
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/receiptKind"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "$ref": "#/$defs/unixSeconds"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "receiptKind": {
      "enum": [
        "tool-call",
        "work-item",
        "pull-request",
        "commit",
        "board-message",
        "run-record",
        "ancestry-check",
        "digest",
        "document"
      ]
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      },
      "description": "Honesty: at least one receipt read in this episode."
    },
    "unixSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds since the Unix epoch."
    }
  }
}
