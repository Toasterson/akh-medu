training/episodes/p6-3b-20260913-indist/

# Python bytecode caches (scripts/, benchmarks/*.py harness drivers).
__pycache__/
*.pyc

# Ignore the per-worktree Anima owner marker.
.anima-owner

# Lilith C6a WireGuard tunnel: the filled-in config (real hostnames/IPs) and
# any locally rendered artifacts or peer state. Key material itself must
# never resolve under the repo at all -- render.py/peer.py refuse to write
# there -- this is defense in depth against an accidental filled-in copy or
# a --out-dir pointed at the repo by mistake.
scripts/lilith/wireguard/wg-config.toml
scripts/lilith/wireguard/*.private
scripts/lilith/wireguard/*.public
scripts/lilith/wireguard/peers.json
