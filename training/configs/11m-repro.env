# The MEASURED 11M ablation config (2026-07-18) — the regression baseline.
# Reproducing this should give in-dist chain ~0.918 / ans ~0.99 by ~step 7500.
# Use it to sanity-check a new box or a refactor before spending 350M money.
MODEL=p1a
LR=3e-4            # fine at 11M; DESTABILIZES 50M+ (see README#lr-at-scale)
WARMUP_STEPS=0
LR_MIN_RATIO=1.0   # no decay -- constant LR, exact byte-for-byte repro
EPOCHS=6           # 15000 steps at 40000 examples / batch 16
TRAIN_EXAMPLES=40000
BATCH_SIZE=16
CKPT_EVERY=2000
EVAL_EVERY=2500
HOLDOUT=128
EVAL_MAX_NEW_TOKENS=260
LOGIC=rule
ARM=trace
TYPED_SLOTS=true
SEED=42
PREDS_PER_CELL=6
MAX_LEVEL=6
GUARD_PROB=0.5
DISTRACTOR_FACTS=4
DISTRACTOR_RULES=6
YES_FRAC=0.5
TRAIN_DEPTHS=2,3,4
EVAL_DEPTHS=5,6
BPE_VOCAB_SIZE=3000
MAX_SEQ_LEN=1024
RUN_NAME=p11m-repro
