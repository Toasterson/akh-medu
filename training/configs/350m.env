# Phase 51 — 350M foundation run hyperparameters (single source of truth).
# Sourced by training/scripts/run-350m.sh. Every value that differs from the
# measured 11M ablation config carries the reason inline.

# --- model ---
# The 350M preset must exist in TinyTransformerConfig (see run-350m.sh's
# preflight check, which fails loudly if it doesn't). Target shape ~350M:
# d_model 1024, 24 layers, 16 heads, d_ff 4096.
MODEL=p1a_350m

# --- LR: THE load-bearing change vs 11M (see training/README.md#lr-at-scale) ---
# Measured: lr 3e-4 converged 11M by step ~7500 but left 50M undertrained with
# depressed trace-validity at step 15000. Scale down + warm up at 350M.
LR=1e-4
WARMUP_STEPS=2000

# --- schedule ---
# 350M needs far more steps than 11M's 15000 (which 50M already outgrew).
# Checkpoint often: this run spans days of on-and-off GPU time.
EPOCHS=12
TRAIN_EXAMPLES=40000
BATCH_SIZE=16
CKPT_EVERY=2000

# --- eval cadence (expensive: `generate` has no KV-cache) ---
# Measured the hard way: holdout 256 @ eval-every 500 cost ~13 min PER EVAL and
# projected 40h of pure eval for a 4-run ladder. Keep it cheap during training;
# run the precision eval (eval_rule --n 512) at the END when the GPU is free.
EVAL_EVERY=2500
HOLDOUT=128
EVAL_MAX_NEW_TOKENS=260

# --- corpus (identical to the measured ablations — do not drift) ---
LOGIC=rule
ARM=trace
TYPED_SLOTS=true          # Q2: typing KEPT by decision (uncertainty-prior)
SEED=42
PREDS_PER_CELL=6
MAX_LEVEL=6
GUARD_PROB=0.5
DISTRACTOR_FACTS=4
DISTRACTOR_RULES=6
YES_FRAC=0.5
TRAIN_DEPTHS=2,3,4
EVAL_DEPTHS=5,6           # unseen depths; chain here is expected 0.000 (the
                          # length-generalization wall is architectural — see
                          # the P4 plan's Q5 verdict. Watch it, don't chase it.)
BPE_VOCAB_SIZE=3000
MAX_SEQ_LEN=1024          # depth-6 sequences reach ~800 tok on the saturated
                          # BPE (~355 effective vocab); 640 truncates them.

RUN_NAME=p350m
