    "source": "def align_up(value: int, alignment: int) -> int:\n    if not (0 <= value <= 65535) or not (0 <= alignment <= 65535):\n        return -1\n    if alignment <= 0 or (alignment & (alignment - 1)) != 0:\n        return -1\n    remainder = value % alignment\n    if remainder == 0:\n        result = value\n    else:\n        result = value + (alignment - remainder)\n    if result > 65535:\n        return -1\n    return result",
