  "algorithm": "token regression with independent auxiliary Monte Carlo sampler draws",
  "equation": "-mean_responses sum_tokens stopgrad(R-beta*(logp_action-logq_action))*(logp_action-mean_j(logp_aux_j))",
  "constraints": [
    "Actual collection sampler q is fixed, not a separate reference model.",
    "Auxiliary draws IID with replacement, independent of complete rollout and across prefixes.",
    "Complete trajectories; include termination tokens; exclude prompt, padding and tool observations.",
    "Sum tokens, average responses; no length normalization, group centering, clipping, importance multiplier or critic.",
    "Consume each auxiliary bank once for this probe; repeated adaptive reuse is not fresh unbiased estimation."
  ],
