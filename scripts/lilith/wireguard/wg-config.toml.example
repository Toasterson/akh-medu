# Lilith C6a — WireGuard pod-client configuration, Variant C (CHOSEN).
#
# Copy to `wg-config.toml` next to this file (gitignored). No private key
# ever goes into this file: slot keys live only in 1Password and are read at
# call time by `peer.py slot-assign` / rotated by `peer.py slot-release`.
#
# Variant C (operator decision 2026-09-28): the hub is the Flux-managed
# `wg-lilith` pod on archibald's k0s cluster, defined in the talos repo
# (GitHub Toasterson/talos, clusters/archibald/lilith-wg — README there is
# the hub runbook). The hub terminates on archibald and forwards only the
# allowlisted services into wg-home (the home router's 3 WireGuard
# credentials are fully allocated, and LAN -> archibald times out). The hub,
# its allowlist and the slot public keys are GitOps state in talos; this
# side renders pod clients and hands out slot keys. There is no SSH path.
#
# Variants A/B (hub + hephaistos gateway managed over SSH) are superseded;
# see wg-config.variant-a.toml.example.
#
# ADR: docs/ai/decisions/116-lilith-chief-of-staff-guided-rl.md (Decision 3)
# Runbook: docs/ops/lilith-wireguard.md

[tunnel]
variant = "C"
subnet = "10.201.0.0/24"            # talos lilith-wg/hub.env TRANSIT_CIDR
listen_port = 51822                 # talos lilith-wg/hub.env LISTEN_PORT
dns = []                            # every forward is addressed by IP

[hub]
host = "archibald.solstice-ci.org"
# IPv4 literal: onetun/wireproxy need no resolver inside the pod.
public_endpoint = "95.216.66.53:51822"
tunnel_address = "10.201.0.1/32"
# As committed in talos lilith-wg/README.md. slot-assign re-reads it from
# 1Password (item lilith-wg-hub, field public_key) and warns on mismatch.
public_key = "L4EYWLhJwTI8JKLtikrdLw2+5iRaSI2xfT7N47+Pdio="

[slots]
count = 4
first_address = "10.201.0.11"       # slot n = 10.201.0.(10 + n)/32
vault = "Homelab"
op_command = "~/.local/bin/op-service-account"
hub_item = "lilith-wg-hub"
item_prefix = "lilith-wg-slot-"     # items lilith-wg-slot-1..4: private_key, public_key, address
# Lease records (slot, run, pod id, public key; never key material). Must
# resolve outside any repository checkout.
lease_dir = "~/.config/akh-medu/lilith-wireguard/slots"
# A talos checkout. Slot state and allowlist parity are read with
# `git show <talos_ref>:<path>` — i.e. what is merged, not the work tree.
talos_repo = "~/ws/talos"
talos_ref = "origin/main"
talos_peers_path = "clusters/archibald/lilith-wg/peers.conf"
talos_allowlist_path = "clusters/archibald/lilith-wg/allowlist.conf"

# --- Services ----------------------------------------------------------
# Enabled, non-bypass entries become onetun/wireproxy forwards on the pod
# and must match the ENABLED entries of talos lilith-wg/allowlist.conf
# exactly (peer.py slot-assign refuses on drift). Tunnelled hosts must be
# IPv4 literals.
#
# Fields: name, host, port, protocol, bypass_gateway, local_port (pod bind,
# default = port), enabled (default true), hostnames (mapped to 127.0.0.1 in
# the pod's /etc/hosts), description.

[[services]]
name = "lab-gateway-http"
host = "192.168.1.12"
port = 80
protocol = "tcp"
bypass_gateway = false
local_port = 80                     # Host-header routing: bind :80 (root in the pod)
hostnames = ["seshat.lab.home", "board.lab.home"]
description = "Internal Envoy Gateway *.lab.home HTTP: Seshat MCP http://seshat.lab.home/mcp, Agent Board http://board.lab.home (talos allowlist lab-gateway-http)"

[[services]]
name = "akh-sessions-home"
host = "10.0.1.2"
port = 18240
protocol = "tcp"
bypass_gateway = false
description = "Home akhsessd via the relay's SSH reverse forward on archibald (talos allowlist akh-sessions-home)"

[[services]]
name = "akh-sandbox-akhsbxd"
host = "10.0.1.2"
port = 8242
protocol = "tcp"
bypass_gateway = false
enabled = false
description = "akhsbxd sandbox-home-access — OFF on the hub (would bypass session tool grants)"

[[services]]
name = "openindiana-vm-executor"
host = "192.168.1.114"
port = 10115
protocol = "tcp"
bypass_gateway = false
enabled = false
description = "PLACEHOLDER: future OpenIndiana VM executor on hephaistos; port unconfirmed, OFF on the hub"

[[services]]
name = "anima-mcp"
host = "anima.wegmueller.it"
port = 443
protocol = "tcp"
bypass_gateway = true
description = "Anima MCP — public HTTPS, reached directly (not tunnelled)"

[[services]]
name = "forgejo"
host = "code.aopc.cloud"
port = 443
protocol = "tcp"
bypass_gateway = true
description = "Forgejo — public HTTPS, reached directly (not tunnelled)"

[[services]]
name = "akh-acp-public"
host = "anima.wegmueller.it"
port = 443
protocol = "tcp"
bypass_gateway = true
description = "Public akh ACP endpoint https://anima.wegmueller.it/akh — reached directly"
