# /etc/lilith-serve/server.env: non-secret settings for lilith-serve.service (ADR 121).
# Read by systemd (EnvironmentFile) and by run_server.sh. KEY=VALUE, no quotes, no `export`.
# install_service.sh creates this file from the example once and never overwrites it; edit it,
# then `sudo systemctl restart lilith-serve`. The API key is NOT here: it is the 0600 file below.

# Bind the LAN address only (never 0.0.0.0): the endpoint is plain HTTP on the operator's LAN.
LILITH_LLAMA_HOST=192.168.1.114
LILITH_LLAMA_PORT=8080

# Served model name; the lilith akh's `model = "lilith"` does not change.
LILITH_MODEL_NAME=lilith

# Two slots (a chat turn and a board-woken turn at once), each with a 65536-token context: the
# akh's context_window is 49152 and 65536 - 49152 leaves room for output and the akh's token
# estimation error. The KV pool is parallel x per-slot context.
LILITH_LLAMA_PARALLEL=2
LILITH_LLAMA_CTX_PER_SLOT=65536

# KV cache type: f16 (default), or q8_0 to halve it (measure first; needs flash attention).
LILITH_LLAMA_KV_TYPE=f16
# Host RAM for the prompt cache of evicted slots (MiB).
LILITH_LLAMA_CACHE_RAM_MIB=4096
# Unload the model from the GPU after this many idle seconds (0 = never). The GPU is shared
# with training experiments; a reload from the page cache takes seconds to a minute.
LILITH_LLAMA_SLEEP_IDLE_SECONDS=0
# Extra llama-server flags, space-separated (tuning only, e.g. `-ub 1024`).
LILITH_LLAMA_EXTRA_ARGS=

# Paths (install_service.sh keeps `current` pointing at the verified build and model).
LLAMA_SERVER=/opt/lilith-serve/current/bin/llama-server
LILITH_GGUF=/var/lib/lilith-serve/models/current/lilith-parent-q8_0.gguf
LILITH_CHAT_TEMPLATE=/var/lib/lilith-serve/models/current/chat_template.jinja
LILITH_API_KEY_FILE=/etc/lilith-serve/api-key

# ROCm runtime and the service user's cache (shader/kernel caches).
LD_LIBRARY_PATH=/opt/rocm/lib
HOME=/var/lib/lilith-serve
XDG_CACHE_HOME=/var/lib/lilith-serve/cache
